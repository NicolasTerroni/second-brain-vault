TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
WHISPER_MODEL=small
# WHISPER_PRELOAD=1         # load the model at startup (0 = on first voice note, saves RAM while idle)
# OCR_LANGS=eng+spa         # Tesseract languages for the sensitive-data check on photos
# BRIEF_TIME=08:00          # morning brief in the bot's TZ; off = none
# REVIEW_TIME=Sun 18:00     # weekly review prompt; off = none
# Optional. Without it, X posts come from the public fxtwitter API.
X_API_BEARER_TOKEN=

# Optional. Docker compose reads these too.
# PUID=1000                 # Linux: your `id -u`, so files in the vault are owned by you
# PGID=1000                 # Linux: your `id -g`
# TZ=UTC                    # timezone for note timestamps, e.g. Europe/Madrid
# YTDLP_COOKIES=/vault/scripts/cookies.txt
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=90
# BACKUP_FOLDER=Vault-backup

# Optional: your Everyday habit tracker app (scripts/habits.py, scripts/coach.py). The token's SHA-256 goes in the app's INTEGRATION_TOKEN_SHA256.
HABITS_API_URL=
HABITS_API_TOKEN=

# Optional: the personal trainer (scripts/trainer.py; brief and persona in 02 - Areas/Training/Coach.md).
# A second bot from @BotFather. It runs inside the capture bot's container and starts when this is set.
TRAINER_BOT_TOKEN=
# Claude Code for the coach's voice and answers: run `claude setup-token` on your PC and paste the token here.
# Without it the coach works with fixed messages.
CLAUDE_CODE_OAUTH_TOKEN=
# TRAINER_PLAN_TIME=Sun 20:00     # weekly report + next week's plan
# TRAINER_ASK_TIME=21:30          # the evening before a training day: what time tomorrow?
# TRAINER_MORNING_TIME=08:00      # missed-day follow-up, sick check-in, time question if unanswered
# TRAINER_QUIET=22:30-07:00       # no messages unless you write first
# TRAINER_NAG_EVERY=20            # minutes between nags after your planned time
# TRAINER_NAG_MAX=6               # nags per day at most
# TRAINER_TARGET=3                # sessions per week (default: the routine's target_per_week)
# TRAINER_AI=claude               # off = fixed messages only
# TRAINER_MOBILITY_TIME=09:00     # daily mobility nags start (or at the app's mobility reminder, if earlier)
# TRAINER_MOBILITY_EVERY=30
# TRAINER_MOBILITY_MAX=6

# Optional: the English teacher (scripts/teacher.py; brief and persona in 02 - Areas/English/English Teacher.md).
# Its own bot from @BotFather; runs inside the capture bot's container and uses its Whisper. Uses CLAUDE_CODE_OAUTH_TOKEN too.
TEACHER_BOT_TOKEN=
# The bots' @usernames, so they can point you to each other (scripts/team.py). Optional.
# ASSISTANT_BOT_USERNAME=
# TRAINER_BOT_USERNAME=
# TEACHER_BOT_USERNAME=
# TEACHER_DRILL_TIME=08:30        # daily drill on a past correction (spaced repetition)
# TEACHER_GRAMMAR_TIME=13:00      # daily grammar set: 4 quiz polls + 1 rewrite, built on your mistakes
# TEACHER_SPEAK_TIME=18:00        # speaking session on speaking days
# TEACHER_SPEAK_DAYS=Mon-Sun      # every day by default; or e.g. Mon-Fri
# TEACHER_REVIEW_TIME=Sun 19:00   # weekly report
# TEACHER_QUIET=22:30-07:00
# TEACHER_NAG_EVERY=30            # minutes between nags until today's target
# TEACHER_NAG_MAX=6
# TEACHER_START_TARGET=120        # seconds; +15 s every 3 days in a row on target, up to 360
# TEACHER_AI=claude               # off = no corrections or answers (the agent corrects at organize)
# CHECKIN_TIME=21:00
# NAG_EVERY=60
# NAG_GRACE=30
# NAG_UNTIL=23:00
